# Variable NAMES only. Never commit real values.

# --- PostgreSQL (application source of truth) ---
# The public address, used in link previews and the sitemap
SITE_URL=http://localhost:3000
DATABASE_URL=postgres://lapikud:lapikud@localhost:5432/lapikud

# --- FreeIPA authentication ---
FREEIPA_SERVER=ipa.lapikud.ee
# Pin only when targeting a server older than the client library.
FREEIPA_CLIENT_VERSION=
FREEIPA_TIMEOUT_MS=10000

# --- Session cookie ---
# Generate with: openssl rand -base64 48
SESSION_SECRET=
SESSION_COOKIE_NAME=lapikud_session
SESSION_TTL_SECONDS=43200

# --- Garage S3 (task photos images) ---
# The bucket MUST stay private. Never apply a public bucket policy to it.
GARAGE_ENDPOINT=http://localhost:3900
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
GARAGE_PHOTO_BUCKET=lapikud-photos
GARAGE_REGION=garage
# Set when the browser reaches Garage on a different origin than the server does.
GARAGE_PUBLIC_ENDPOINT=

# --- Photos limits (optional; sensible defaults are built in) ---
PHOTO_MAX_FILE_SIZE_BYTES=5242880
PHOTO_MAX_PER_PROOF=5
PHOTO_UPLOAD_URL_TTL_SECONDS=300
PHOTO_DOWNLOAD_URL_TTL_SECONDS=300

# --- Web Push (optional; all three or none) ---
# Generate the pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services, e.g. mailto:board@lapikud.ee
VAPID_SUBJECT=

# --- Weekly photo backup to Nextcloud (optional; all three or none) ---
# e.g. https://cloud.example.org/remote.php/dav/files/username
NEXTCLOUD_WEBDAV_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_BACKUP_PATH=/lapikud-photo-backups
